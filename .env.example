# Copy this file to .env and replace development values as needed.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://async_processing:async_processing@localhost:5433/async_processing
RABBITMQ_URL=amqp://async_processing:async_processing@localhost:5672/
FRANKFURTER_BASE_URL=https://api.frankfurter.dev
CURRENCY_ALLOWLIST_PATH=config/currencies-v1.json
CONSUMER_PREFETCH=8
CONSUMER_CONCURRENCY=4
CONSUMER_SHUTDOWN_SECONDS=30
DATABASE_POOL_SIZE=4
DATABASE_POOL_TIMEOUT=5
DATABASE_STATEMENT_TIMEOUT_MS=10000
RATE_TIMEOUT_SECONDS=5
# Host compatibility mode only. Compose and Kubernetes explicitly use instance.
METRICS_MODE=multiprocess
RATE_FALLBACK_DAYS=7
OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Export this before starting both API and consumer processes; they must share this directory.
# It is read by prometheus-client during Python import, not loaded from .env at runtime.
PROMETHEUS_MULTIPROC_DIR=/tmp/async-processing-prometheus
